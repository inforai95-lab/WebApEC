@model IEnumerable<WebApEC.Models.Employee>

<h2>Employee List</h2>
<h2>Home Page</h2>

<form asp-controller="Employee" asp-action="Create" method="get">
    <button type="submit" class="btn btn-primary">
        Open Employee Form
    </button>
</form>

@Html.ActionLink("Go to About Page", "Privacy", "Home")
<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Salary</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var emp in Model)
        {
            <tr>
                <td>@emp.EmployeeId</td>
                <td>@emp.Name</td>
                <td>@emp.Email</td>
                <td>@emp.Department</td>
                <td>@emp.Salary</td>
            </tr>
        }
    </tbody>
</table>
